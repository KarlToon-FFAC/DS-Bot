{
  "host": "127.0.0.1",
  "port": 3190,
  "databasePath": "./data/hub.sqlite",
  "management": {
    "enabled": true,
    "adminPasswordEnv": "DSBOT_HUB_ADMIN_PASSWORD",
    "url": "wss://hub.example.test:3190/communication",
    "pairingCaFile": "./certs/ca.pem"
  },
  "peers": [],
  "tls": {
    "certificateEnv": "DSBOT_HUB_TLS_CERT",
    "privateKeyEnv": "DSBOT_HUB_TLS_KEY"
  }
}
