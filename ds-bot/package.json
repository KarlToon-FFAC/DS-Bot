{
  "name": "ds-bot",
  "version": "0.3.1",
  "description": "DS Bot: a team of long-lived Bots for DeepSeek Harness, with Main Bots, Bot-to-Bot messages and group chats",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/Fei2411/DS-Bot#readme",
  "bugs": {
    "url": "https://github.com/Fei2411/DS-Bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fei2411/DS-Bot.git",
    "directory": "ds-bot"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "src/office/",
    "client.js",
    "office.js",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "bin/",
    "skills/"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/dsh-session-format-catalog": "*",
    "@deepseek-ai/dsh-session-log-export": "*",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "*",
    "@deepseek-ai/dsh-storage": "*",
    "@deepseek-ai/dsh-storage-json": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-session-projection-cache": "*",
    "@deepseek-ai/dsh-user-approval": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "deep-view": "0.1.0",
    "ws": "8.22.1",
    "yaml": "2.9.1"
  },
  "bin": {
    "dsbot-remote": "./bin/dsbot-remote.mjs",
    "dsbot-team": "./bin/dsbot-team.mjs",
    "dsbot-reset": "./bin/dsbot-reset.mjs"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-format-catalog": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-log-export": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-v3-to-v4": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-json": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection-cache": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  }
}
